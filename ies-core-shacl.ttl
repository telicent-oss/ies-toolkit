    sh:class ies_core:Activity ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Warning ;
    sh:message "Participation isPartOf must point to a Activity or one of its subclasses" ;
] .

ies_core_sh:ParticipationInGovernanceShape sh:property [
    sh:path ies_top:isPartOf ;
    sh:or ( [ sh:class ies_core:GovernanceActivity ] [ sh:class ies_core:Organization ] ) ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Warning ;
    sh:message "ParticipationInGovernance isPartOf must point to one of: GovernanceActivity, Organization (or a subclass)" ;
] .

ies_core_sh:ParticipationInGovernanceShape sh:property [
    sh:path ies_top:isTemporalPartOf ;
    sh:class ies_core:Person ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Warning ;
    sh:message "ParticipationInGovernance isTemporalPartOf must point to a Person or one of its subclasses" ;
] .

